{
  "manifest_version": 3,
  "name": "SwipePrep Autofill",
  "version": "1.0.0",
  "description": "Connects SwipePrep to job application pages — detect the job, see your match score, and autofill applications from your SwipePrep profile. It never submits for you.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["{{API_ORIGIN}}/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SwipePrep",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://apply.lever.co/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
