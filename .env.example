# SwipePrep environment variables
# Copy to .env.local for Next.js and .env for Prisma CLI

# Neon PostgreSQL (pooled connection recommended for serverless)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# App URL (local or production)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Gemini
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_FLASH_MODEL="gemini-2.5-flash"
GEMINI_PRO_MODEL="gemini-2.5-pro"

# OAuth (optional — email/password works without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# UploadThing
UPLOADTHING_TOKEN=""

# Background jobs (optional — without QStash, jobs self-invoke via HTTP)
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
WORKER_SECRET="replace-with-worker-hmac-secret"

# Rate limits (daily per user)
RATE_LIMIT_RESUME_PARSE="10"
RATE_LIMIT_ROADMAP="20"
